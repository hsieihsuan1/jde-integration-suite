# Copy to .env and export the variables (the code reads os.environ, not the file).
# Leave JDE_BASE_URL unset to use the built-in mock server.
JDE_BASE_URL=https://your-jde-host.example.com/jderest/v3/orchestrator
JDE_USER=
JDE_PASSWORD=
# Keep TLS verification on. Only set to false for a lab host you control.
JDE_VERIFY_SSL=true
JDE_STOCK_ORCHESTRATOR=Stock_Item_Availability
JDE_METER_ORCHESTRATOR=JDE_ORCH_Sample_UpdateMeterReadings
JDE_DEFAULT_BRANCH_PLANT=550
